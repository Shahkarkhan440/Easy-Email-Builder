{
  "name": "easy-email-builder-mcp",
  "version": "0.1.3",
  "description": "MCP server for Easy Email Builder: generate email templates with AI, render them to HTML, and get a link to open them in the visual editor",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "email",
    "email-template",
    "email-builder",
    "html-email"
  ],
  "author": "shahkar khan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shahkarkhan440/Easy-Email-Builder.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/Shahkarkhan440/Easy-Email-Builder/tree/main/mcp#readme",
  "mcpName": "io.github.Shahkarkhan440/easy-email-builder",
  "type": "module",
  "bin": {
    "easy-email-builder-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
