    "pack:extension": "node build.mjs && node pack-extension.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.5",
    "linkedom": "^0.18.12",
    "typescript": "^5.4.0",
    "zod": "4.6.5"
  }
